# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments and secrets (keep example templates)
.venv/
venv/
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Build output and Python package metadata
/dist/
/build/
*.egg-info/

# Test coverage and isolated test environments
.coverage
.coverage.*
/htmlcov/
/coverage.xml
.tox/
.nox/

# Editor/OS temporary files
*.swp
*.swo
*~
.DS_Store

# Do not ignore *.img, *.efi, *.SYS or *.COM globally:
# upstream/ boot assets and tests/fixtures/ must remain versioned.
